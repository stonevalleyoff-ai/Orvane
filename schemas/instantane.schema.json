{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orvane/schemas/instantane.schema.json",
  "title": "Orvane — instantané (sortie du moteur)",
  "description": "L'état du vivant d'un monde à un cycle donné. Orvane ne connaît aucun jeu : tout est biologie abstraite. Le traducteur du jeu lit ce fichier et en fait des données jouables.",
  "type": "object",
  "required": [
    "orvane",
    "monde",
    "cycle",
    "biomes",
    "catalogue",
    "taxons"
  ],
  "additionalProperties": false,
  "properties": {
    "orvane": {
      "type": "string",
      "description": "Version du contrat, ex. « 0.1 »."
    },
    "monde": {
      "type": "object",
      "required": [
        "id",
        "graine"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Un monde par jeu : identifiant stable du monde."
        },
        "graine": {
          "type": "integer",
          "description": "Graine du monde. Même graine + mêmes pressions ⇒ même histoire."
        },
        "nom": {
          "type": "string"
        },
        "annee": {
          "type": "integer",
          "minimum": 0,
          "description": "Durée de l’année en cycles (0 ou absent : pas de saisons). Phase 0 = plein hiver, 0,5 = plein été."
        },
        "genese": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cycles": {
              "type": "integer"
            },
            "graine": {
              "type": "integer"
            },
            "ancetres": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "Si le monde est né de la genèse (moteur/genese.js) : combien de cycles, quelle graine, quels ancêtres."
        },
        "ne": {
          "type": "string",
          "format": "date-time",
          "description": "La naissance du monde (le premier cycle, posé par hebergement/cycle.js). Avec l'id, c'est l'identité d'un monde : un monde refait de zéro garde son id mais change de date — les traducteurs repartent alors de sa nouvelle génération 0."
        }
      }
    },
    "cycle": {
      "type": "object",
      "required": [
        "n",
        "date"
      ],
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0,
          "description": "Numéro de cycle, croissant de 1 à chaque tour du moteur."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "Quand le cycle a été calculé (UTC)."
        },
        "pressions_recues": {
          "type": "integer",
          "description": "Nombre d'événements de pression intégrés dans ce cycle."
        },
        "saison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "nom"
          ],
          "properties": {
            "phase": {
              "$ref": "#/$defs/unite"
            },
            "nom": {
              "enum": [
                "hiver",
                "printemps",
                "été",
                "automne"
              ]
            },
            "production": {
              "type": "number",
              "description": "Facteur de production des biomes à saisons ce cycle (0,75 en plein hiver, 1,25 en plein été par défaut)."
            }
          }
        }
      }
    },
    "biomes": {
      "type": "array",
      "minItems": 1,
      "description": "Les biomes sont décrits par des axes, pas par des noms : un jeu fait correspondre ses propres biomes aux axes.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "milieu",
          "axes",
          "capacite"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "nom": {
            "type": "string"
          },
          "milieu": {
            "enum": [
              "terrestre",
              "aquatique",
              "amphibie",
              "aerien",
              "souterrain"
            ]
          },
          "axes": {
            "type": "object",
            "required": [
              "temperature",
              "humidite",
              "altitude",
              "lumiere",
              "couvert"
            ],
            "additionalProperties": false,
            "description": "Chaque axe va de 0 à 1 : 0 = froid/sec/bas/sombre/nu, 1 = chaud/humide/haut/lumineux/dense.",
            "properties": {
              "temperature": {
                "$ref": "#/$defs/unite"
              },
              "humidite": {
                "$ref": "#/$defs/unite"
              },
              "altitude": {
                "$ref": "#/$defs/unite"
              },
              "lumiere": {
                "$ref": "#/$defs/unite"
              },
              "couvert": {
                "$ref": "#/$defs/unite"
              }
            }
          },
          "capacite": {
            "type": "number",
            "minimum": 0,
            "description": "Capacité d'accueil totale (unités de biomasse abstraites)."
          },
          "voisins": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Biomes vers lesquels une population peut migrer."
          },
          "capacite_base": {
            "type": "number",
            "minimum": 0,
            "description": "Capacité d’origine, vers laquelle le biome regagne lentement après une perte d’habitat."
          },
          "saisons": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "temperature": {
                    "type": "number"
                  },
                  "lumiere": {
                    "type": "number"
                  },
                  "humidite": {
                    "type": "number"
                  },
                  "capacite": {
                    "type": "number"
                  }
                }
              }
            ],
            "description": "Amplitudes saisonnières de ce biome (false : aucune, ex. une grotte ou un volcan). Par défaut : température ±0,15, lumière ±0,1, humidité ±0,08, production ±25 %."
          },
          "axes_saison": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/unite"
            },
            "description": "Les axes tels qu’ils sont en cette saison (axes reste la valeur annuelle, stable : c’est elle qu’un traducteur fait correspondre)."
          },
          "catastrophes": {
            "type": "boolean",
            "description": "false : ce biome est à l’abri des catastrophes (incendie, crue, sécheresse)."
          }
        }
      }
    },
    "catalogue": {
      "type": "object",
      "required": [
        "version",
        "traits"
      ],
      "additionalProperties": false,
      "description": "Les traits cités par les phénotypes de cet instantané, avec ce qu'ils impliquent. Un trait n'est jamais une stat de jeu : c'est un organe, un coût, un effet, un comportement. Les traits y sont dans l’ordre du catalogue du moteur : c’est lui qui dit qui masque qui (docs/9).",
      "properties": {
        "version": {
          "type": "string"
        },
        "traits": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "domaine",
              "organe",
              "cout",
              "effet"
            ],
            "additionalProperties": false,
            "properties": {
              "domaine": {
                "enum": [
                  "morphologie",
                  "locomotion",
                  "sens",
                  "offense",
                  "defense",
                  "metabolisme",
                  "reproduction",
                  "social",
                  "activite"
                ]
              },
              "organe": {
                "type": "string",
                "description": "Ce que le corps porte pour ce trait (glande, carapace, membrane…)."
              },
              "cout": {
                "type": "number",
                "minimum": 0,
                "description": "Surcoût énergétique relatif par rapport au plan de base (0.15 = +15 %)."
              },
              "effet": {
                "type": "string",
                "description": "Ce que le trait permet, en langage biologique (« projette une sécrétion irritante à 3 longueurs de corps »)."
              },
              "comportement": {
                "type": "string",
                "description": "Conduite induite, si le trait en impose une (« embuscade, riposte à distance »)."
              },
              "exige": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Traits requis pour que celui-ci existe (cohérence des combinaisons)."
              },
              "exclut": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fournit": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Matières que l'organe laisse derrière lui (pour les traducteurs : objets, récolte)."
              },
              "ecarts": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                },
                "description": "Multiplicateurs appliqués au plan corporel (masse_kg, longevite, portee…)."
              },
              "fixe": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Valeurs imposées au plan (activite, regime)."
              },
              "vulnerabilite": {
                "type": "number",
                "minimum": 0,
                "description": "Multiplicateur de la chance d’être mangé (0.55 = une carapace divise presque par deux). 1 = neutre."
              },
              "chasse": {
                "type": "number",
                "minimum": 0,
                "description": "Multiplicateur de l’efficacité de chasse (1.25 = crocs allongés). 1 = neutre."
              },
              "resistance": {
                "type": "number",
                "minimum": 0,
                "description": "Multiplicateur de la mortalité par maladie (0.85 résiste ; 1.25 : le groupe propage). 1 = neutre."
              },
              "conduite": {
                "type": "object",
                "description": "Ce que l'organe fait faire à la bête, en vocabulaire abstrait (docs/7-conduites.md). type : riposte-distance, riposte-contact, defense-contact, repli, protection, immobilite, alerte-groupe, defense-petits, vol-plane, vision-nocturne, perception-proche, vue-diurne-faible, morsure, sprint, lenteur, escalade, nage, avertissement, activite-crepuscule. presage : ce qu'un joueur attentif voit avant qu'elle ne se déclenche.",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "effet": {
                    "type": "string"
                  },
                  "portee": {
                    "type": "number"
                  },
                  "recharge": {
                    "type": "number"
                  },
                  "force": {
                    "type": "number"
                  },
                  "presage": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "heredite": {
                "enum": [
                  "dominant",
                  "recessif"
                ],
                "description": "Dominant (par défaut) : une copie de l’allèle suffit à montrer le trait. Récessif : il en faut deux ; deux parents qui ne le montrent pas peuvent le transmettre (docs/9)."
              },
              "attrait": {
                "type": "number",
                "minimum": 0,
                "description": "Ce que le trait pèse dans le choix du partenaire : 1,6, un porteur a 60 % de chances en plus d’être choisi pour père (docs/9)."
              }
            }
          }
        },
        "quantitatifs": {
          "type": "object",
          "description": "Les traits continus (docs/8) et ce qu’ils modulent : champ du plan, mode (log : × e^(echelle·z) ; lin : + echelle·z), héritabilité de départ, largeur de la sélection stabilisante, pentes de prédation, de fécondité, de maladie, optimum selon un axe du biome.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "champ",
              "mode",
              "echelle",
              "h2"
            ],
            "properties": {
              "champ": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "log",
                  "lin"
                ]
              },
              "echelle": {
                "type": "number"
              },
              "h2": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "omega2": {
                "type": "number"
              },
              "predation": {
                "type": "number"
              },
              "fecondite": {
                "type": "number"
              },
              "maladie": {
                "type": "number"
              },
              "optimum": {
                "type": "object",
                "properties": {
                  "axe": {
                    "type": "string"
                  },
                  "pente": {
                    "type": "number"
                  }
                }
              },
              "effet": {
                "type": "string"
              }
            }
          }
        },
        "organes": {
          "type": "object",
          "description": "Les types d'organes (moteur/corps.js, docs/11) : places possibles, nombre, formes, fonction, mots pour les décrire, et la conduite qu'un organe prête au jeu (charge, riposte-contact, protection, repli…), forte en proportion de sa taille. Ajouter un type, c'est une entrée ici : ni le schéma ni les jeux ne changent.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "places",
              "nombre",
              "formes",
              "fonction",
              "mot"
            ],
            "properties": {
              "places": {
                "type": "array",
                "items": {
                  "enum": [
                    "tete",
                    "dos",
                    "flancs",
                    "queue",
                    "avant"
                  ]
                },
                "minItems": 1
              },
              "nombre": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 2
              },
              "defaut": {
                "type": "integer",
                "minimum": 1
              },
              "formes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "fonction": {
                "type": "string"
              },
              "mot": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "fem": {
                "type": "integer",
                "enum": [
                  0,
                  1
                ]
              },
              "conduite": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "force": {
                    "type": "number"
                  },
                  "effet": {
                    "type": "string"
                  },
                  "nom": {
                    "type": "string"
                  },
                  "presage": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "taxons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "apparu",
          "statut",
          "plan",
          "populations",
          "phenotypes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable dans le temps ; un jeu peut l'associer à une entité."
          },
          "nom": {
            "type": "string",
            "description": "Nom donné par le moteur (ou gardé si le jeu en a proposé un)."
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "description": "Taxon dont celui-ci s'est séparé (lignée)."
          },
          "apparu": {
            "type": "integer",
            "description": "Cycle d'apparition."
          },
          "eteint": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Cycle d'extinction, sinon null. Un taxon éteint reste listé 10 cycles."
          },
          "statut": {
            "enum": [
              "croissance",
              "stable",
              "declin",
              "menace",
              "eteint"
            ]
          },
          "plan": {
            "type": "object",
            "description": "Le plan corporel de base, commun à tous les phénotypes.",
            "required": [
              "masse_kg",
              "taille_m",
              "locomotion",
              "regime",
              "longevite",
              "maturite",
              "sociabilite",
              "temperament",
              "activite"
            ],
            "additionalProperties": false,
            "properties": {
              "masse_kg": {
                "type": "number",
                "minimum": 0
              },
              "taille_m": {
                "type": "number",
                "minimum": 0
              },
              "locomotion": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "marche",
                    "course",
                    "saut",
                    "nage",
                    "vol",
                    "fouissage",
                    "reptation",
                    "grimpe"
                  ]
                }
              },
              "regime": {
                "enum": [
                  "herbivore",
                  "carnivore",
                  "omnivore",
                  "detritivore",
                  "filtreur"
                ]
              },
              "longevite": {
                "type": "number",
                "description": "En cycles."
              },
              "maturite": {
                "type": "number",
                "description": "Âge de reproduction, en cycles."
              },
              "portee": {
                "type": "number",
                "description": "Descendants par reproduction (moyenne)."
              },
              "sociabilite": {
                "$ref": "#/$defs/unite",
                "description": "0 solitaire, 1 grégaire."
              },
              "temperament": {
                "$ref": "#/$defs/unite",
                "description": "0 fuit toujours, 1 riposte toujours."
              },
              "activite": {
                "enum": [
                  "diurne",
                  "nocturne",
                  "crepusculaire",
                  "continue"
                ]
              },
              "vitesse_rel": {
                "type": "number",
                "description": "Vitesse de pointe en longueurs de corps par seconde."
              },
              "perception": {
                "$ref": "#/$defs/unite",
                "description": "Acuité des sens (portée relative)."
              },
              "niche": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "description": "Axes du biome idéal (mêmes clés que biomes.axes). Sans niche, tout biome au milieu compatible convient."
              },
              "tolerance": {
                "type": "number",
                "minimum": 0.05,
                "description": "Largeur de la niche : écart-type de la convenance sur la distance entre axes (0.35 par défaut)."
              },
              "corps": {
                "type": "object",
                "description": "La silhouette (moteur/corps.js) : des proportions de 0 à 1 et des couleurs, pour qu'un jeu dessine une lignée qu'il n'a jamais vue. Dérive à chaque séparation. Les organes (cornes, massue, aiguillon…) apparaissent, grandissent et se perdent ; les scalaires cornes, crête, ailes, carapace, antennes en sont le résumé (la plus grande taille du type), pour les lecteurs anciens. Facultatif.",
                "properties": {
                  "forme": {
                    "enum": [
                      "quadrupede",
                      "hexapode",
                      "bipede",
                      "oiseau",
                      "serpent"
                    ]
                  },
                  "pattes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8
                  },
                  "long": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "haut": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "cou": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "tete": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "museau": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "oreilles": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "queue": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "cornes": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "crete": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "ailes": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "carapace": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "antennes": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "organes": {
                    "type": "array",
                    "maxItems": 16,
                    "description": "Les organes de la silhouette (docs/11). Chaque type se pose à une place (tête, dos, flancs, queue, avant) ; sa taille va de 0,2 à 1 ; un organe qui passe sous 0,2 se perd. Ce qu'il fait au jeu (charger, piquer, amortir) est dans ORGANES_CAT.",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "taille"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "type": "string",
                          "pattern": "^[a-z][a-z-]*$",
                          "description": "Un type du catalogue (catalogue.organes) ; un lecteur qui ne le connaît pas l'ignore."
                        },
                        "place": {
                          "enum": [
                            "tete",
                            "dos",
                            "flancs",
                            "queue",
                            "avant"
                          ]
                        },
                        "taille": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "nombre": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 12
                        },
                        "forme": {
                          "type": "string",
                          "description": "Une des formes que le catalogue donne à ce type."
                        }
                      }
                    }
                  },
                  "motif": {
                    "enum": [
                      "uni",
                      "rayures",
                      "taches",
                      "bandes",
                      "masque"
                    ]
                  },
                  "couleurs": {
                    "type": "object",
                    "properties": {
                      "robe": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "sombre": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "ventre": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "oeil": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "minItems": 3,
                        "maxItems": 3
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "populations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "biome",
                "effectif",
                "tendance"
              ],
              "additionalProperties": false,
              "properties": {
                "biome": {
                  "type": "string"
                },
                "effectif": {
                  "type": "number",
                  "minimum": 0
                },
                "tendance": {
                  "type": "number",
                  "description": "Variation relative sur le cycle (−0.12 = −12 %)."
                },
                "pression": {
                  "$ref": "#/$defs/unite",
                  "description": "Part de la mortalité du cycle due aux pressions externes (joueurs)."
                },
                "depuis": {
                  "type": "integer",
                  "description": "Cycle d’installation dans ce biome (sert à la séparation des lignées)."
                },
                "predation": {
                  "$ref": "#/$defs/unite",
                  "description": "Part de la mortalité du cycle due aux prédateurs."
                },
                "satiete": {
                  "$ref": "#/$defs/unite",
                  "description": "Prédateurs et omnivores : à quel point les proies suffisent (0 = famine, 1 = rassasié). Un traducteur peut en faire l’agressivité."
                },
                "maladie": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "reste",
                    "virulence"
                  ],
                  "properties": {
                    "reste": {
                      "type": "integer",
                      "description": "Cycles avant que l’épidémie ne s’éteigne."
                    },
                    "virulence": {
                      "type": "number",
                      "description": "Mortalité supplémentaire par cycle, avant résistance et entassement."
                    },
                    "part": {
                      "$ref": "#/$defs/unite",
                      "description": "Part de la mortalité du cycle due à la maladie."
                    }
                  },
                  "description": "Une épidémie en cours dans cette population."
                },
                "quant": {
                  "type": "object",
                  "description": "Les traits continus de cette population (docs/8) : pour chacun, la moyenne m, la variance phénotypique v et la variance additive g, en écarts-types naturels de la génération 0 (z = 1 : un écart-type au-dessus de la moyenne d’alors). Un jeu tire chaque bête dans N(m, v) ; l’héritabilité est g / v. Ce que vaut un écart-type sur le plan : catalogue.quantitatifs.",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "m",
                      "v",
                      "g"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "m": {
                        "type": "number"
                      },
                      "v": {
                        "type": "number",
                        "minimum": 0
                      },
                      "g": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                },
                "alleles": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "description": "La reproduction sexuée (docs/9) : pour chaque trait, la fréquence de l’allèle qui le porte dans cette population. Une bête en a deux copies ; un trait dominant se voit chez une part 1 − (1 − p)² des bêtes, un récessif chez p². Un allèle récessif peut donc être bien plus répandu que le trait ne se voit."
                },
                "flux": {
                  "$ref": "#/$defs/unite",
                  "description": "Le flux de gènes reçu : la part d’immigrants par cycle, en moyenne glissante (docs/10). Près de 0, la population est isolée."
                },
                "divergence": {
                  "type": "number",
                  "minimum": 0,
                  "description": "L’écart génétique de cette population au reste de l’espèce : le F_ST de leurs allèles, plus le quart de l’écart moyen des traits continus (docs/10). Au-delà de REGLES.separation.divergence, une population isolée peut devenir une lignée."
                },
                "hybride": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "avec",
                    "part",
                    "isolement"
                  ],
                  "description": "Une zone hybride (docs/10) : une lignée apparentée vit dans le même biome et s’y croise.",
                  "properties": {
                    "avec": {
                      "type": "string",
                      "description": "La lignée avec laquelle elle se croise le plus."
                    },
                    "part": {
                      "$ref": "#/$defs/unite",
                      "description": "La part des naissances de cette population qui a un père de l’autre lignée et survit."
                    },
                    "isolement": {
                      "$ref": "#/$defs/unite",
                      "description": "L’isolement reproductif entre les deux (0 : une seule population ; 1 : aucun croisement)."
                    }
                  }
                },
                "mefiance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Ce que la population a appris des joueurs (docs/12) : la méfiance, nourrie des contacts qui finissent mal (prélèvements, captures), retombe de moitié en 6 cycles. Absente : 0."
                },
                "habituation": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "L'habituation, nourrie des rencontres sans suite et de l'aide (nourrissage, libération), défaite par ce qui finit mal, retombe de moitié en 15 cycles. Absente : 0."
                }
              }
            }
          },
          "phenotypes": {
            "type": "array",
            "minItems": 1,
            "description": "Combinaisons cohérentes de traits, avec leur fréquence dans le taxon. Les fréquences somment à 1. Le premier est le phénotype de base.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "frequence",
                "traits"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "frequence": {
                  "$ref": "#/$defs/unite"
                },
                "frequence_par_biome": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/unite"
                  }
                },
                "traits": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Identifiants du catalogue. Vide pour le phénotype de base."
                },
                "cout_total": {
                  "type": "number",
                  "description": "Somme des coûts : ce que ce phénotype paie en énergie."
                },
                "ecarts": {
                  "type": "object",
                  "description": "Ce que le phénotype change au plan (multiplicateurs).",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "selection": {
                  "type": "number",
                  "description": "Avantage sélectif net du cycle (positif : la fréquence monte)."
                }
              }
            }
          }
        }
      }
    },
    "evenements": {
      "type": "array",
      "description": "Ce qui s'est passé de notable dans le cycle : lisible par le visualiseur et par un jeu qui veut le raconter.",
      "items": {
        "type": "object",
        "required": [
          "type",
          "taxon"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "apparition",
              "extinction",
              "separation",
              "migration",
              "effondrement",
              "explosion",
              "nouveau_trait",
              "epidemie",
              "remission",
              "catastrophe",
              "hybridation",
              "mefiance"
            ]
          },
          "taxon": {
            "type": "string"
          },
          "biome": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "precedent": {
      "type": "object",
      "description": "Le cycle d'avant, allégé (effectifs par biome, fréquences des phénotypes), joint à l'instantané publié : tous les traducteurs interpolent entre les deux de la même façon.",
      "properties": {
        "cycle": {
          "type": "integer"
        },
        "taxons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "populations": {
                "type": "array"
              },
              "phenotypes": {
                "type": "array"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "unite": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
